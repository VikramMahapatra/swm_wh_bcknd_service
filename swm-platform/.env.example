# Environment
ENV=dev
LOG_LEVEL=INFO
METRICS_ENABLED=true

# Network
INGESTION_API_HOST=0.0.0.0
INGESTION_API_PORT=8001
WEBSOCKET_API_HOST=0.0.0.0
WEBSOCKET_API_PORT=8002
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8003
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL (AWS RDS / EC2)
POSTGRES_HOST=postgres.example.internal
POSTGRES_PORT=5432
POSTGRES_DB=swm_platform
POSTGRES_USER=swm_user
POSTGRES_PASSWORD=change-me
POSTGRES_SSLMODE=require
# $ in password must be URL-encoded as %24 in the DSN
POSTGRES_DSN=postgresql+asyncpg://swm_user:change-me@postgres.example.internal:5432/swm_platform?ssl=require

# ClickHouse (EC2)
CLICKHOUSE_HOST=clickhouse.example.internal
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me
CLICKHOUSE_DSN=http://clickhouse.example.internal:8123

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=30
AUTH_ENFORCE_JWT=true
AUTH_ALLOW_LEGACY_ROLE_HEADER=false
AUTH_LEGACY_DEFAULT_ROLE=admin
AUTH_API_KEYS_JSON=[]
# Bootstrap seed users for initial DB setup; runtime auth is DB-backed.
AUTH_USERS_JSON=[{"username":"admin","password":"admin123","role":"admin","subject":"admin-user","permissions":["*"]}]

# Ingestion webhook auth (phase-wise enablement)
INGESTION_WEBHOOK_AUTH_ENABLED=false
INGESTION_WEBHOOK_SECRET=
INGESTION_WEBHOOK_SECRET_HEADER=X-Webhook-Secret
INGESTION_WEBHOOK_HMAC_SECRET=
INGESTION_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
INGESTION_WEBHOOK_ALLOWED_IPS=
INGESTION_WEBHOOK_NONCE_TTL_SECONDS=0
INGESTION_WEBHOOK_NONCE_HEADER=X-Webhook-Nonce
INGESTION_WEBHOOK_VENDOR_HEADER=X-Vendor-Id

# Ingestion rate limits (phase-wise enablement)
INGESTION_RATE_LIMIT_ENABLED=false
INGESTION_RATE_LIMIT_PREFIX=rl:ingestion
INGESTION_RATE_LIMIT_GLOBAL_LIMIT=2000
INGESTION_RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
INGESTION_RATE_LIMIT_VENDOR_LIMIT=1000
INGESTION_RATE_LIMIT_VENDOR_WINDOW_SECONDS=60
INGESTION_RATE_LIMIT_IP_LIMIT=400
INGESTION_RATE_LIMIT_IP_WINDOW_SECONDS=60
INGESTION_RATE_LIMIT_IMEI_LIMIT=180
INGESTION_RATE_LIMIT_IMEI_WINDOW_SECONDS=60

# WebSocket auth
WEBSOCKET_AUTH_REQUIRED=true

# Pickup crossing detection
PICKUP_CROSS_RADIUS_M=30
PICKUP_CROSS_COOLDOWN_SECONDS=900
GTC_TRIP_RADIUS_M=30
GTC_TRIP_HALT_SECONDS=180
FIRST_PICKUP_GRACE_MINUTES=15
