ADMIN_API_PORT=8003

# PostgreSQL (AWS RDS / EC2)
POSTGRES_HOST=ec2-13-203-201-10.ap-south-1.compute.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=swm_bknd_db
POSTGRES_USER=zenadmin
POSTGRES_PASSWORD=Zen$123
POSTGRES_SSLMODE=require
# $ in password must be URL-encoded as %24 in the DSN
POSTGRES_DSN=postgresql+asyncpg://zenadmin:Zen%24123@ec2-13-203-201-10.ap-south-1.compute.amazonaws.com:5432/swm_bknd_db?ssl=require

# ClickHouse (EC2)
CLICKHOUSE_HOST=13.200.249.92
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=Zen$123
CLICKHOUSE_DSN=http://13.200.249.92:8123

# Redis
